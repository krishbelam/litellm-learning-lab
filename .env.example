# Replace both sample secrets before starting LiteLLM.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=change-this-to-a-long-random-master-key
LITELLM_SALT_KEY=change-this-to-a-different-long-random-salt

# Local PostgreSQL for the LiteLLM Proxy.
POSTGRES_DB=litellm
POSTGRES_USER=litellm_user
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://litellm_user:change-this-database-password@db:5432/litellm

# Optional: required only when enabling the OpenAI model in config.yaml.
OPENAI_API_KEY=

# Client-side key generated by LiteLLM UI. Do not use the master key here.
# Export this in your shell rather than committing a real key.
LITELLM_VIRTUAL_KEY=


# To test model-level access control through virtual keys
BOOKSTORE_BASIC_KEY=
BOOKSTORE_PRO_KEY=

# Model that is created in confg.yaml
# Also seen in the LiteLLM UI
LITELLM_MODEL=

# Local URL
LITELLM_BASE_URL=
